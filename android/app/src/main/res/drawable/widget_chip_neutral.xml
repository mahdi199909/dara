<?xml version="1.0" encoding="utf-8"?>
<!-- Shortcut chip on the widgets: a translucent neutral grey with a hairline border. Being neutral
     and see-through it reads on a light, a dark or a coloured widget background alike, which the old
     fixed light-grey chip did not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#2E808080" />
    <stroke android:width="1dp" android:color="#4D808080" />
    <corners android:radius="999dp" />
</shape>
