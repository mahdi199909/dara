<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_capital_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_theme_shape"
    android:clipToOutline="true">

    <!-- Optional user color/opacity theme (WidgetTheme.java); transparent = original look. -->
    <FrameLayout
        android:id="@+id/widget_theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Text colours here are only the first-paint defaults; the provider sets them from the
             theme (WidgetTheme.getTextColor) on every update so they always contrast with the
             background. -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_capital_title"
            android:textDirection="rtl"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/capital_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="rtl"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- GridView (not the plain row of three buttons this used to be) is what gives the
             shortcuts real touch-scrolling inside a widget — see CapitalShortcutsService for the
             RemoteViewsFactory backing it. setEmptyView (CapitalWidgetProvider) needs its target to
             be a sibling of the grid within this same inflated tree, hence the wrapping FrameLayout. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/shortcuts_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="rtl"
                android:numColumns="3"
                android:horizontalSpacing="6dp"
                android:verticalSpacing="6dp"
                android:stretchMode="columnWidth"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
                android:scrollbarSize="3dp"
                android:fadeScrollbars="false" />

            <TextView
                android:id="@+id/shortcuts_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_capital_shortcuts_empty"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:textColor="#B3111111"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />

        </FrameLayout>
    </LinearLayout>
</FrameLayout>
