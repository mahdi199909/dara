<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 by default (see widget_quick_capture_info.xml) — just a tap target, no room for the old
     icon+title+subtitle card. The tap still opens the same QuickCaptureActivity text capsule. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_theme_shape"
    android:clipToOutline="true">

    <!-- Optional user color/opacity theme (WidgetTheme.java); transparent = original look. -->
    <FrameLayout
        android:id="@+id/widget_theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/capture_plus_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:contentDescription="@string/widget_capture_title" />
</FrameLayout>
