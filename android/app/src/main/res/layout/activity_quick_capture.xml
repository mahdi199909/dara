<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capture_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="80dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:background="@drawable/capsule_background"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <EditText
            android:id="@+id/capture_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ثبت ..."
            android:textDirection="rtl"
            android:gravity="right"
            android:textColorHint="#9CA3AF"
            android:textColor="#1A1D29"
            android:textSize="15sp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <!-- Shown only after Done/Enter parses the typed text — a preview of exactly what will be
             saved, plus ✓/✕ (confirm / back to editing). Nothing writes until ✓ is tapped. -->
        <LinearLayout
            android:id="@+id/confirm_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/confirm_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:textDirection="rtl"
                android:gravity="right" />

            <TextView
                android:id="@+id/confirm_edit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="✕"
                android:textColor="#9CA3AF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/confirm_ok"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="✓"
                android:textColor="#0E5F54"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
