# Database
# Local dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, see DEPLOYMENT.md):
# DATABASE_URL="postgresql://hesabkon:CHANGE_ME@localhost:5432/hesabkon?schema=public"

# Auth
# Generate a strong random string for production, e.g: openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-in-production-32chars-min"
SESSION_COOKIE_NAME="hesabkon_session"

# Owner-only /admin tools (subscription management, forced-update config) — must exactly match
# the email of the one account allowed to use them. Leave empty to disable /admin entirely.
ADMIN_EMAIL=""

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Logging (see doc/logging/architecture.md). Every variable is optional.
# LOG_LEVEL="info"                 # production default; development defaults to debug. Overrides: "info,SYNC=debug"
# LOG_FORMAT="json"                # json (server default) | pretty (readable one-liners) | object
# SLOW_API_THRESHOLD_MS="1000"    # a request this slow also writes API_SLOW_REQUEST (older name: LOG_SLOW_REQUEST_MS)
# SLOW_DB_THRESHOLD_MS="300"      # a database call this slow writes DB_SLOW_QUERY (older name: LOG_SLOW_QUERY_MS)
# SLOW_SYNC_THRESHOLD_MS="3000"   # a sync request this slow writes SYNC_SLOW
# SLOW_REPORT_THRESHOLD_MS="2000" # a report this slow also writes REPORT_SLOW
# LOG_FILE_DIR="./logs"           # keep every record in rotated, compressed files here (the owner's timeline reads them); unset = stdout only
# LOG_RETENTION_DAYS="14"         # how long those files are kept: 7, 14, 30, 90 …; 0 / off keeps them until the size ceiling
# LOG_FILE_MAX_MB="300"           # the most they may occupy together
# LOG_REMOTE_URL=""               # a central collector (newline-delimited JSON over HTTP POST); unset = nothing leaves the server
# LOG_REMOTE_TOKEN=""             # sent as "Authorization: Bearer <token>"
# LOG_REMOTE_MIN_LEVEL="warn"     # the lowest level sent there
# METRICS_TOKEN=""                # switches on GET /api/metrics (Prometheus text, bearer token, 16+ characters); unset = no endpoint
# LOG_HASH_SECRET=""              # key for the e-mail pseudonyms in login-failure lines (defaults to JWT_SECRET)
# GIT_COMMIT=""                   # not set here: passed on the deploy command line (see DEPLOYMENT.md 5b)

# The audit trail (Settings → History; see doc/logging/audit.md). Both optional.
# AUDIT_RETENTION_DAYS="730"       # how long entries are kept; 0 / off / never keeps everything
# AUDIT_MONEY_MODE="values"        # values (default) | redacted | flag — how amounts appear in audit entries

# AI (optional — leave empty to run fully rule-based, no AI dependency required)
AI_PROVIDER=""
AI_API_KEY=""

# Membership/upgrade panel's manual-payment fallback (no payment gateway yet) — all shown
# directly in the app, so none of these are secret. For the Android build these must ALSO be set
# as repository variables (not secrets) in GitHub → Settings → Secrets and variables → Actions →
# Variables, named PAYMENT_CARD_NUMBER / PAYMENT_BANK_NAME / PAYMENT_CARD_HOLDER /
# PAYMENT_CONTACT_ID, since the CI build has no .env file and bakes NEXT_PUBLIC_* values in at
# build time (see .github/workflows/build-android.yml).
NEXT_PUBLIC_PAYMENT_CARD_NUMBER=""
NEXT_PUBLIC_PAYMENT_BANK_NAME=""
NEXT_PUBLIC_PAYMENT_CARD_HOLDER=""
NEXT_PUBLIC_PAYMENT_CONTACT_ID=""
