# Database
# Local dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, see DEPLOYMENT.md):
# DATABASE_URL="postgresql://hesabkon:CHANGE_ME@localhost:5432/hesabkon?schema=public"

# Auth
# Generate a strong random string for production, e.g: openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-in-production-32chars-min"
SESSION_COOKIE_NAME="hesabkon_session"

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# AI (optional — leave empty to run fully rule-based, no AI dependency required)
AI_PROVIDER=""
AI_API_KEY=""

# Email (used for the registration email-verification code, see src/lib/email.ts)
RESEND_API_KEY=""

# Membership/upgrade panel's manual-payment fallback (no payment gateway yet) — both are shown
# directly in the app, so neither is secret. For the Android build these must ALSO be set as
# repository variables (not secrets) in GitHub → Settings → Secrets and variables → Actions →
# Variables, named PAYMENT_CARD_NUMBER / PAYMENT_CONTACT_ID, since the CI build has no .env file
# and bakes NEXT_PUBLIC_* values in at build time (see .github/workflows/build-android.yml).
NEXT_PUBLIC_PAYMENT_CARD_NUMBER=""
NEXT_PUBLIC_PAYMENT_CONTACT_ID=""
